# Copy this to `.streamlit/secrets.toml` (local) — or paste the same TOML into
# the app's Secrets panel on Streamlit Community Cloud.
#
# `.streamlit/` is already git-ignored, so the real file never reaches the repo.
# This example file is tracked on purpose: it documents the shape without
# containing a credential.

[postgres]
# SQLAlchemy URL form — note the `+psycopg` driver tag.
# Neon / Supabase / RDS all work; keep `sslmode=require` for anything remote.
url = "postgresql+psycopg://ocip_app:CHANGE_ME@HOST:5432/ocip?sslmode=require"

[ocip]
# Tenant a user lands in when no explicit mapping matches.
default_org = "cityu"
default_site = "GBA-DEMO-01"

# Fallback identity when Streamlit's built-in auth (st.login) is not configured.
# Anyone who opens the app inherits this user and therefore this org — so do not
# expose a public link without real authentication.
dev_user = "liulinda@cityu"

# Optional explicit mapping. Keys are the emails returned by st.user.email.
[ocip.orgs]
"liulinda@cityu.edu.hk" = "cityu"
"partner@example.com" = "partner-org"

# ---------------------------------------------------------------------------
# Public trial — one link anyone can open, and you still see where they stop.
# Set telemetry_only = true (and give a SEPARATE database, not the pilot one):
# sample data is preloaded, uploaded files stay in the visitor's browser,
# no email/IP is recorded, and only the step events are written.
# ---------------------------------------------------------------------------
# telemetry_only = true
#
# [postgres]
# url = "postgresql+psycopg://ocip_public:CHANGE_ME@HOST:5432/ocip_public?sslmode=require"
